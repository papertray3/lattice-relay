{
  "name": "lattice-relay-server",
  "version": "0.1.0",
  "private": true,
  "description": "Lattice Relay stdio MCP server: forwards MCP tool calls to the Lattice Relay Obsidian plugin",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "lattice-relay": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rimraf dist"
  },
  "keywords": [
    "lattice",
    "obsidian",
    "mcp"
  ],
  "author": "papertray3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/papertray3/lattice-relay.git",
    "directory": "servers/node"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
