{
  "name": "lattice-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Lattice Relay: the governed MCP boundary between Lattice and agent clients (Obsidian plugin and stdio server)",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/papertray3/lattice-relay.git"
  },
  "homepage": "https://github.com/papertray3/lattice-relay#readme",
  "bugs": {
    "url": "https://github.com/papertray3/lattice-relay/issues"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:install": "npm ci --prefix servers/node",
    "server:check": "npm --prefix servers/node run typecheck && npm --prefix servers/node run lint && npm --prefix servers/node test",
    "server:bundle": "node scripts/build-server.mjs",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs",
    "release:assemble": "node scripts/assemble-release.mjs",
    "verify": "npm run version:check && npm test && npm run build && npm run server:check && npm run server:bundle"
  },
  "keywords": [
    "lattice",
    "obsidian",
    "obsidian-plugin",
    "mcp",
    "model-context-protocol"
  ],
  "author": "papertray3",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.10",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "chokidar": "^3.6.0",
    "js-yaml": "^4.3.2",
    "ws": "^8.22.2"
  }
}
